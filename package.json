{
  "name": "@mb4it/bitrix-mcp",
  "version": "0.4.3",
  "description": "Local MCP server for Bitrix Framework references, LiveAPI indexing, and semantic documentation search.",
  "type": "module",
  "bin": {
    "bitrix-mcp": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dictator90/bitrix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Dictator90/bitrix-mcp/issues"
  },
  "homepage": "https://github.com/Dictator90/bitrix-mcp#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "start": "node dist/cli.js serve",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "php-parser": "^3.5.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "docs",
    "embeddings",
    "README.md",
    "ru.README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "bitrix",
    "mcp",
    "model-context-protocol",
    "liveapi"
  ],
  "license": "MIT"
}
